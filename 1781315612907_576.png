<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 440 850" width="100%" height="100%">
  <defs>
    <pattern id="p5-stripes" width="20" height="20" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
      <line x1="0" y1="0" x2="0" y2="20" stroke="#050505" stroke-width="10" />
    </pattern>
    <pattern id="p5-dots" width="12" height="12" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.5" fill="#ffffff" opacity="0.15" />
    </pattern>
    <filter id="p5-shadow" x="-5%" y="-5%" width="115%" height="115%">
      <feDropShadow dx="8" dy="8" stdDeviation="0" flood-color="#050505" flood-opacity="1" />
    </filter>
  </defs>

  <g filter="url(#p5-shadow)">
    <polygon points="20,0 410,15 440,50 440,800 400,850 30,840 0,800 0,40" fill="#dc2626" />
  </g>

  <polygon points="280,850 440,850 440,680 340,700" fill="url(#p5-stripes)" />
  <polygon points="0,150 25,180 0,230 30,280 0,350 20,400 0,480" fill="#050505" />
  <polygon points="20,0 410,15 440,50 440,800 400,850 30,840 0,800 0,40" fill="url(#p5-dots)" pointer-events="none" />

  <polygon points="0,40 240,25 320,65 430,53 410,15 20,0" fill="#050505" />
  <g transform="translate(-10, 100) rotate(-15)">
    <polygon points="0,0 80,-5 75,30 -5,32" fill="#ffffff" stroke="#050505" stroke-width="2" />
    <text x="12" y="22" font-family="Impact, Arial Black, sans-serif" font-size="16" font-weight="900" fill="#050505" letter-spacing="1">CALL</text>
  </g>
  <polygon points="170,25 270,20 268,30 172,33" fill="#f59e0b" />

  <polygon points="20,65 415,75 415,745 20,735" fill="#050505" />
  <polygon points="23,68 412,78 412,742 23,732" fill="#ffffff" />
  
  <polygon points="27,72 408,82 408,738 27,728" fill="none" />
  <polygon points="27,72 408,82 408,738 27,728" stroke="#050505" stroke-width="2" fill="none" stroke-dasharray="6,4" opacity="0.3" />

  <g transform="translate(410, 360) rotate(90)">
    <polygon points="-5,-5 95,-2 90,25 0,22" fill="#f59e0b" stroke="#050505" stroke-width="2" />
    <text x="15" y="16" font-family="monospace" font-size="12" font-weight="bold" fill="#050505">SYS_MEMOS</text>
  </g>
  
  <polygon points="0,780 120,770 200,810 440,790 400,850 30,840 0,800" fill="#050505" />
  
  <g transform="translate(220, 792)">
    <polygon points="0,-22 22,0 0,22 -22,0" fill="#f59e0b" stroke="#ffffff" stroke-width="3" />
    <polygon points="0,-14 14,0 0,14 -14,0" fill="#050505" />
    <polygon points="0,-5 5,0 0,5 -5,0" fill="#f59e0b" />
  </g>

  <path d="M 40 810 L 50 820 L 60 810" stroke="#ffffff" stroke-width="3" fill="none" />
  <path d="M 380 820 L 390 810 L 400 820" stroke="#ffffff" stroke-width="3" fill="none" />
</svg>
